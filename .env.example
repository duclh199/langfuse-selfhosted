# Copy to .env and replace every CHANGEME. Never commit .env.
# [secret] = store in AWS Secrets Manager / SSM on ECS.

# Public URL of Langfuse web (e.g. https://langfuse.example.com)
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=CHANGEME            # [secret] openssl rand -base64 32
SALT=CHANGEME                       # [secret] openssl rand -base64 32
ENCRYPTION_KEY=CHANGEME             # [secret] openssl rand -hex 32 (64 hex chars)

# Postgres (password must match DATABASE_URL)
POSTGRES_PASSWORD=CHANGEME          # [secret]
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres   # [secret]

CLICKHOUSE_PASSWORD=CHANGEME        # [secret]
REDIS_AUTH=CHANGEME                 # [secret]

# MinIO / S3 (all four must be the same value when using MinIO)
MINIO_ROOT_PASSWORD=CHANGEME                        # [secret]
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME # [secret]
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME # [secret]
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME # [secret]
# Public URL of blob storage, reachable from the browser
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://localhost:9190

# Initial org + admin user, created on first start if missing
LANGFUSE_INIT_ORG_ID=default-org
LANGFUSE_INIT_ORG_NAME=Default Org
LANGFUSE_INIT_USER_EMAIL=CHANGEME
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME # [secret] use a strong password
